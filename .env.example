# ─────────────────────────────────────────────────────────────
# Ingon — environment variables
# Copy this file to `.env.local` and fill in your values:
#   cp .env.example .env.local
# NEVER commit .env.local. Keys stay on the server only
# (none are prefixed with NEXT_PUBLIC_, so they are not exposed
# to the browser).
# ─────────────────────────────────────────────────────────────

# REQUIRED. Your Google Gemini API key.
# Get a free one at https://aistudio.google.com/apikey
INGON_API_KEY=

# Gemini's OpenAI-compatible endpoint.
INGON_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# The real model id sent to the provider. If you get a "model not found"
# error, copy a current free model id from Google AI Studio.
INGON_MODEL=gemini-2.5-flash

# The name shown in the chat header (display only).
INGON_MODEL_LABEL=tugon-chat

# Upper bound on tokens generated per reply (caps usage per request).
INGON_MAX_OUTPUT_TOKENS=1024

# Some providers want "max_completion_tokens" instead of "max_tokens".
# Allowed: max_tokens | max_completion_tokens
INGON_MAX_TOKENS_PARAM=max_tokens

# Optional. Leave blank to use the model's default.
INGON_TEMPERATURE=

# Optional. Replace Ingon's built-in system prompt.
INGON_SYSTEM_PROMPT=

# Only for session-aware proxies (e.g. FreeDeepseekAPI). Leave false for Gemini.
INGON_SEND_SESSION_HEADER=false

# Per-IP rate limit: INGON_RATE_LIMIT_MAX requests per window (seconds).
INGON_RATE_LIMIT_MAX=20
INGON_RATE_LIMIT_WINDOW_SEC=60

# Optional. Comma-separated extra origins allowed to call /api/chat
# (same-origin requests are always allowed). Example:
#   https://ingon.example.com,https://www.example.com
INGON_ALLOWED_ORIGINS=


make gemini a sample AI-model connection for the example, but you can use any OpenAI-compatible model. If you want to use a different model, just change the INGON_MODEL and INGON_MODEL_LABEL values in your .env.local file.